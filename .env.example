# ==========================================
# VanSure Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values

# Application
APP_NAME=VanSure
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database - PostgreSQL with PostGIS
# Create a database user and database first:
# CREATE USER vansure WITH PASSWORD 'secure_password';
# CREATE DATABASE vansure_db OWNER vansure;
# GRANT ALL PRIVILEGES ON DATABASE vansure_db TO vansure;
DATABASE_URL="postgresql://vansure:secure_password@localhost:5432/vansure_db"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT Authentication
# Generate secrets for production: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-256-bits
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800
JWT_AUDIENCE=vansure
JWT_ISSUER=vansure-api

# Password Hashing (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX_AUTH_REQUESTS=5
RATE_LIMIT_MAX_GPS_REQUESTS=20
RATE_LIMIT_MAX_GENERAL=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_CSV_EXPORT=true
ENABLE_MQTT=false

# GPS Tracking
GPS_LOCATION_TTL_SECONDS=300
GPS_BATCH_SIZE=100
GPS_ARCHIVE_INTERVAL_SECONDS=300

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400
ENABLE_IDEMPOTENCY=true

# External Services (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false
METRICS_PATH=/metrics